# ⚠️ IMPORTANT SÉCURITÉ ⚠️
# NE JAMAIS committer le fichier .env avec de vraies valeurs !
# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs
# En production, utilisez les variables d'environnement de votre hébergeur

# Database (Supabase PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# NextAuth
# ⚠️ PRODUCTION: Changez NEXTAUTH_URL vers votre domaine (https://votredomaine.com)
NEXTAUTH_URL=http://localhost:3000
# ⚠️ CRITICAL: Générez une clé secrète unique de 32+ caractères
# PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
# Ou: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-CHANGE-THIS-IN-PRODUCTION

# Google OAuth
# Créez vos credentials sur: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth (pour Outlook)
# Créez votre app sur: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# OpenAI
# ⚠️ Gardez cette clé secrète ! Ne jamais exposer côté client
# Obtenez votre clé sur: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
DEFAULT_AI_MODEL=gpt-4o-mini

# Stripe (Paiements) - IMPORTANT: Utilisez les clés LIVE en production
# Mode TEST: pk_test_... et sk_test_...
# Mode LIVE: pk_live_... et sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE_STRIPE
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_STRIPE
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_WEBHOOK_SECRET

# Stripe Price IDs - Plan STARTER (2,500 emails/mois)
# Product ID: prod_TOMWKelR0td3Qq (mensuel) / prod_TOMaAnyds5G7xk (annuel)
STRIPE_PRICE_STARTER_MONTHLY=price_1SRZnAGJn0NQpREzi7BPOUHo  # 49€/mois
STRIPE_PRICE_STARTER_YEARLY=price_1SRZqtGJn0NQpREzYuOzUHzr   # 490€/an

# Stripe Price IDs - Plan PRO (7,500 emails/mois)
# Product ID: prod_TOMcqfE1FrVqE3 (mensuel) / prod_TOMhpteujZDir7 (annuel)
STRIPE_PRICE_PRO_MONTHLY=price_1SRZtWGJn0NQpREz0gNLKR4f      # 139€/mois
STRIPE_PRICE_PRO_YEARLY=price_1SRZxdGJn0NQpREzmfljBgDr       # 1,390€/an

# Stripe Price IDs - Plan ENTERPRISE (25,000 emails/mois)
# Product ID: prod_TOMkJWK6SLHGPS (mensuel) / prod_TOMmBUcGLrqEMX (annuel)
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_1SRa0kGJn0NQpREzTuH4lAXq  # 229€/mois
STRIPE_PRICE_ENTERPRISE_YEARLY=price_1SRa2tGJn0NQpREzwxIJTK9t   # 2,290€/an

# Stripe Price IDs - Plan FREE (optionnel, généralement non utilisé)
STRIPE_PRICE_FREE_MONTHLY=
STRIPE_PRICE_FREE_YEARLY=

# Resend (Email)
# Obtenez votre clé sur: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
# ⚠️ Utilisez un domaine vérifié en production
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Rate Limiting (Recommandé pour production)
# Créez un compte gratuit sur: https://upstash.com/
# En développement, un rate limiting en mémoire est utilisé
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Sentry (Monitoring - Optionnel)
# Pour le monitoring des erreurs en production
# Créez un compte sur: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# App Config
# ⚠️ PRODUCTION: Changez vers votre domaine (https://votredomaine.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ⚠️ PRODUCTION: Définir à "production"
NODE_ENV=development

# ==========================================
# CHECKLIST DE SÉCURITÉ AVANT PRODUCTION
# ==========================================
# [ ] NEXTAUTH_SECRET changé (32+ caractères aléatoires)
# [ ] NEXTAUTH_URL pointe vers le domaine de production
# [ ] NEXT_PUBLIC_APP_URL pointe vers le domaine de production  
# [ ] NODE_ENV=production
# [ ] Stripe clés LIVE (pk_live_, sk_live_)
# [ ] SSL/TLS activé sur le serveur
# [ ] Domaine email vérifié dans Resend
# [ ] Google OAuth configuré avec le bon domaine
# [ ] Microsoft OAuth configuré avec le bon domaine
# [ ] Rate limiting Redis configuré (Upstash)
# [ ] Backup base de données automatisé
# [ ] Monitoring configuré (Sentry optionnel)
# [ ] npm audit fix exécuté
# [ ] Tous les secrets sont uniques et sécurisés

