# Mail Center - Configuration

# ============================================
# GMAIL OAUTH (Google Cloud Console)
# ============================================
# 1. Aller sur https://console.cloud.google.com
# 2. Créer projet ou utiliser existant
# 3. Activer Gmail API
# 4. Créer identifiants OAuth 2.0
# 5. URI de redirection: http://localhost:3000/api/mail-center/gmail/callback
# 6. Copier les valeurs ci-dessous

GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================
# OUTLOOK/MICROSOFT OAUTH (Azure Portal)
# ============================================
# 1. Aller sur https://portal.azure.com
# 2. Azure AD > App registrations > New registration
# 3. URI de redirection: http://localhost:3000/api/mail-center/outlook/callback
# 4. Permissions: Mail.Read, Mail.Send, Mail.ReadWrite, offline_access
# 5. Créer Client Secret
# 6. Copier Application (client) ID et Secret

MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# ============================================
# ENCRYPTION (Sécurité Tokens)
# ============================================
# Générer une clé de 32 caractères aléatoires
# Exemple: openssl rand -base64 32

ENCRYPTION_KEY=your-32-character-random-key-here!!

# ============================================
# OPENAI API (Déjà configuré normalement)
# ============================================
# Si pas encore fait, obtenir sur https://platform.openai.com

OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ============================================
# APP URL (Important pour OAuth redirects)
# ============================================
# Development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (à modifier lors du déploiement)
# NEXT_PUBLIC_APP_URL=https://mailwizard.vercel.app

# ============================================
# SUPABASE (Déjà configuré)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# NEXTAUTH (Déjà configuré)
# ============================================
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
